# ===========================================
# IMSS Diabetes Analytical Agent - Environment Configuration
# ===========================================

# --- OpenAI API ---
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- SQL Server Database ---
DB_SERVER=11.33.41.96
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# --- Master Access Key (simple gate before login/register) ---
#
# Comparte este valor SOLO con los usuarios autorizados a usar el agente.
# El frontend lo pedira antes de mostrar la pantalla de login.
# Si se deja vacio, la proteccion queda DESHABILITADA (util en desarrollo local).
#
# Puede ser cualquier texto facil de recordar y compartir (no necesita ser
# aleatorio). Ejemplo: Diabetes-IMSS-2026
#
# Si prefieres una llave generada aleatoriamente:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_KEY=Diabetes-IMSS-2026

# --- OpenSSL Configuration (Legacy SQL Server Support) ---
# 
# WHEN TO USE:
# - Ubuntu 22.04 production server connecting to SQL Server 2008/2012
# - You see error: "SSL routines::unsupported protocol"
#
# WHEN NOT NEEDED:
# - Windows development with modern SQL Server (2016+)
# - No SSL/TLS handshake errors
#
# HOW TO SET:
# 1. Ensure the OpenSSL config file exists at the specified path
# 2. The file must have SECLEVEL=0 and UnsafeLegacyRenegotiation=yes
# 3. File must be readable (chmod 644)
#
# Example for Ubuntu production:
# OPENSSL_CONF=/etc/shiny-server/openssl.cnf
#
# Leave commented out for Windows development unless needed:
# OPENSSL_CONF=
